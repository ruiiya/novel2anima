{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/novel2anima/v4/outfit_revision.schema.json",
  "title": "OutfitProposal V4 (DRAFT)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "stage",
    "character_id",
    "items",
    "uncertainties"
  ],
  "properties": {
    "schema_version": {
      "const": "v4-draft-1"
    },
    "stage": {
      "const": "04_wardrobe"
    },
    "character_id": {
      "type": "integer",
      "minimum": 1
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "slot",
          "garment_type",
          "silhouette",
          "material",
          "color",
          "construction_details"
        ],
        "properties": {
          "slot": {
            "type": "string"
          },
          "garment_type": {
            "type": "string"
          },
          "silhouette": {
            "type": "string"
          },
          "material": {
            "type": "string"
          },
          "color": {
            "type": "string"
          },
          "construction_details": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "anchor_asset_id": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1
    },
    "uncertainties": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
