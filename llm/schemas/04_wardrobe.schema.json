{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/novel2anima/v4/04_wardrobe.schema.json",
  "title": "WardrobeProposal",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "stage",
    "status",
    "decisions",
    "uncertainties",
    "evidence_refs",
    "items"
  ],
  "properties": {
    "schema_version": {
      "const": "v4-1"
    },
    "stage": {
      "const": "04_wardrobe"
    },
    "status": {
      "enum": [
        "proposed",
        "needs_review"
      ]
    },
    "decisions": {
      "type": "object"
    },
    "uncertainties": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "slot",
          "garment_type"
        ],
        "properties": {
          "item_code": {
            "type": "string"
          },
          "slot": {
            "type": "string",
            "minLength": 1
          },
          "garment_type": {
            "type": "string",
            "minLength": 1
          },
          "silhouette": {
            "type": "string"
          },
          "material": {
            "type": "string"
          },
          "base_color": {
            "type": "string"
          },
          "details": {
            "type": "object"
          }
        }
      }
    }
  }
}
