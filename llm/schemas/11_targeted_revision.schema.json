{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/novel2anima/v4/11_targeted_revision.schema.json",
  "title": "TargetedRevisionProposal",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "stage",
    "status",
    "decisions",
    "uncertainties",
    "evidence_refs",
    "revision"
  ],
  "properties": {
    "schema_version": {
      "const": "v4-1"
    },
    "stage": {
      "const": "11_targeted_revision"
    },
    "status": {
      "enum": [
        "proposed",
        "needs_review"
      ]
    },
    "decisions": {
      "type": "object"
    },
    "uncertainties": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "revision": {
      "type": "object",
      "required": [
        "reason",
        "axes"
      ],
      "properties": {
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "axes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
