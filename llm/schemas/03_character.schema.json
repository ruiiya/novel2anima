{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/novel2anima/v4/03_character.schema.json",
  "title": "CharacterProposal",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "stage",
    "status",
    "decisions",
    "uncertainties",
    "evidence_refs",
    "characters"
  ],
  "properties": {
    "schema_version": {
      "const": "v4-1"
    },
    "stage": {
      "const": "03_character"
    },
    "status": {
      "enum": [
        "proposed",
        "needs_review"
      ]
    },
    "decisions": {
      "type": "object"
    },
    "uncertainties": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "characters": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "name"
        ],
        "properties": {
          "code": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "identity": {
            "type": "object"
          }
        }
      }
    }
  }
}
