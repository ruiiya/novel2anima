{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/novel2anima/v4/shot_direction.schema.json",
  "title": "ShotDirectionProposal V4 (DRAFT)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "stage",
    "shot_id",
    "participants",
    "interactions",
    "outfit_bindings",
    "camera",
    "uncertainties"
  ],
  "properties": {
    "schema_version": {
      "const": "v4-draft-1"
    },
    "stage": {
      "const": "06_shot_direction"
    },
    "shot_id": {
      "type": "integer",
      "minimum": 1
    },
    "participants": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "uniqueItems": true,
      "items": {
        "type": "integer",
        "minimum": 1
      }
    },
    "interactions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "actor_character_id",
          "target_character_id",
          "action_code"
        ],
        "properties": {
          "actor_character_id": {
            "type": "integer",
            "minimum": 1
          },
          "target_character_id": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1
          },
          "action_code": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "outfit_bindings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "character_id",
          "outfit_revision_id"
        ],
        "properties": {
          "character_id": {
            "type": "integer",
            "minimum": 1
          },
          "outfit_revision_id": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    },
    "camera": {
      "type": "string"
    },
    "uncertainties": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
